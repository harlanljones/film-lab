# Film Lab — response headers for Workers Static Assets (FL-DEPLOY-03 / HJ-401).
# Copied verbatim by Vite from public/ to dist/_headers. Cloudflare applies these
# to the worker's static responses. CSP is strict for this SPA; vite client dev
# server adds its own nonces, so this file only affects the production build.

/*
  Content-Security-Policy: script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Hashed, immutable build assets: cache for a year. These filenames are content-hashed.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html and the bare root must revalidate so new deploys take effect immediately.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
