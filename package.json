{
  "name": "film-lab",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first 7-on-7 flag-football playbook and film room.",
  "author": "Harlan Jones",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlanljones/film-lab.git"
  },
  "homepage": "https://github.com/harlanljones/film-lab",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "vitest run src/e2e",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "preview": "vite preview",
    "fps": "node scripts/fps-harness.mjs",
    "deploy": "tsc -b && vite build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
