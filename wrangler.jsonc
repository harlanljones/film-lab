// Film Lab — static hosting only (ROADMAP U4, Linear HJ-332, FL-DEPLOY-03 HJ-401, FL-DEPLOY-07 HJ-405).
// Serves the Vite build via Workers Static Assets; no Worker code, no server-side storage.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "film-lab",
  "compatibility_date": "2026-08-24",
  "placement": { "mode": "smart" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": ["https://film-lab.harlanljones.workers.dev/*", "https://film-lab.harlanljones.com/*"]
}
